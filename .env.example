# Copy to .env for local use. Never commit .env.
# Local PostgreSQL credentials are development-only and must not be reused in AWS.

# Application environment: local | test | dev | prod
# Type: string | Secret: no | Applies: all
APP_ENV=local

# Log level: DEBUG | INFO | WARNING | ERROR
# Type: string | Secret: no | Applies: all
APP_LOG_LEVEL=INFO

# Semantic version reported by /api/v1/version
# Type: string | Secret: no | Applies: all
APP_VERSION=0.1.0

# Git commit SHA injected at image build time
# Type: string | Secret: no | Applies: all
GIT_SHA=unknown

# RFC 3339 build timestamp injected at image build time
# Type: string | Secret: no | Applies: all
BUILD_TIME=unknown

# SQLAlchemy URL. Driver is normalized to postgresql+psycopg.
# Type: url | Secret: yes | Applies: all
# Local default is not reusable outside this machine.
DATABASE_URL=postgresql+psycopg://budgetlens:budgetlens_local_only@localhost:5433/budgetlens

# Object storage adapter: local | s3
# Type: string | Secret: no | Applies: all
OBJECT_STORAGE_BACKEND=local

# Filesystem path for the local storage adapter
# Type: path | Secret: no | Applies: local, test
LOCAL_STORAGE_PATH=./var/storage

# S3 data bucket (used when OBJECT_STORAGE_BACKEND=s3)
# Type: string | Secret: no | Applies: aws
S3_BUCKET=

# S3 region
# Type: string | Secret: no | Applies: aws
S3_REGION=us-east-1

# Optional key prefix inside the data bucket
# Type: string | Secret: no | Applies: aws
S3_PREFIX=

# Optional custom S3 endpoint (local fakes only)
# Type: url | Secret: no | Applies: local, test
S3_ENDPOINT_URL=

# Authentication adapter: dev | oidc
# Type: string | Secret: no | Applies: all
# AUTH_MODE=dev is rejected unless APP_ENV is local or test.
AUTH_MODE=dev

# OIDC issuer (used when AUTH_MODE=oidc)
# Type: url | Secret: no | Applies: aws
OIDC_ISSUER=

# OIDC audience
# Type: string | Secret: no | Applies: aws
OIDC_AUDIENCE=

# OIDC JWKS URL
# Type: url | Secret: no | Applies: aws
OIDC_JWKS_URL=

# Seconds to cache the OIDC JWKS document
# Type: integer | Secret: no | Applies: aws
OIDC_JWKS_CACHE_SECONDS=300

# PostgreSQL role assumed for API transactions; no BYPASSRLS
# Type: string | Secret: no | Applies: all
DATABASE_RUNTIME_ROLE=budgetlens_app

# HMAC pepper for non-guessable object-storage prefixes
# Type: string | Secret: yes | Applies: all
# Local default is not reusable outside this machine.
STORAGE_KEY_PEPPER=budgetlens-local-storage-pepper

# AI adapter: stub | bedrock
# Type: string | Secret: no | Applies: all
AI_PROVIDER=stub

# Bedrock region (unused while AI_PROVIDER=stub)
# Type: string | Secret: no | Applies: aws
BEDROCK_REGION=us-east-1

# Bedrock model identifier (unused while AI_PROVIDER=stub)
# Type: string | Secret: no | Applies: aws
BEDROCK_MODEL_ID=

# Maximum tool calls per copilot turn
# Type: integer | Secret: no | Applies: all
AI_MAX_TOOL_CALLS=4

# Conversation turns sent to the model
# Type: integer | Secret: no | Applies: all
AI_MAX_CONTEXT_TURNS=12

# Maximum aggregated rows returned by one tool
# Type: integer | Secret: no | Applies: all
AI_MAX_RESULT_ROWS=50

# Copilot timeout budget in seconds
# Type: integer | Secret: no | Applies: all
AI_TIMEOUT_SECONDS=20

# Simultaneous copilot turns per user
# Type: integer | Secret: no | Applies: all
AI_MAX_CONCURRENT_CONVERSATIONS=2

# Import execution seam: inline | process
# Type: string | Secret: no | Applies: all
IMPORT_EXECUTOR=inline

# Export execution seam: inline | process
# Type: string | Secret: no | Applies: all
EXPORT_EXECUTOR=inline

# Conversation text persistence: full_synthetic | redacted
# Type: string | Secret: no | Applies: all
# full_synthetic is allowed only when APP_ENV is local or test. dev and prod
# are forced to redacted until a human accepts the conversation persistence decision.
CONVERSATION_CONTENT_MODE=full_synthetic

# Maximum upload size in bytes (25 MiB)
# Type: integer | Secret: no | Applies: all
MAX_UPLOAD_BYTES=26214400

# Configurable workbook limits for CSV/XLSX imports
# Type: integer | Secret: no | Applies: all
IMPORT_MAX_SHEETS=8
IMPORT_MAX_ROWS=100000
IMPORT_MAX_COLUMNS=40
IMPORT_MAX_CELLS=500000

# Comma-separated browser origins allowed by CORS
# Type: string | Secret: no | Applies: local, test, dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database readiness query timeout in seconds
# Type: float | Secret: no | Applies: all
DB_READY_TIMEOUT_SECONDS=2

# Seconds before a processing import job is marked timed out
# Type: integer | Secret: no | Applies: all
JOB_TIMEOUT_SECONDS=600

# Days to keep original import files before purge
# Type: integer | Secret: no | Applies: all
ORIGINAL_FILE_RETENTION_DAYS=90

# Days to keep detailed import error reports before purge
# Type: integer | Secret: no | Applies: all
ERROR_REPORT_RETENTION_DAYS=30

# Hours to keep export objects before purge
# Type: integer | Secret: no | Applies: all
EXPORT_RETENTION_HOURS=24

# Days to retain audit events as policy. The API does not delete audit rows.
# Type: integer | Secret: no | Applies: all
AUDIT_RETENTION_DAYS=365

# Days to retain technical logs. 14 for local/dev; 30-90 for production.
# Type: integer | Secret: no | Applies: all
LOG_RETENTION_DAYS=14

# Prefix exported CSV with UTF-8 BOM for Excel compatibility
# Type: boolean | Secret: no | Applies: all
CSV_EXPORT_WITH_BOM=true

# Sliding-window limits per user
# Type: integer | Secret: no | Applies: all
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=10

# Estimated AI cost in micros per usage unit. 0 disables the estimate.
# Type: integer | Secret: no | Applies: all
AI_INPUT_UNIT_COST_MICROS=0
AI_OUTPUT_UNIT_COST_MICROS=0

# Host port mappings (Compose interpolation). Change if a port is busy.
# Internal Compose service URLs stay the same.
# Type: integer | Secret: no | Applies: local
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5433

# Run Alembic on API process start. AWS tasks set this to 0 and run migrate once.
# Type: integer | Secret: no | Applies: all
RUN_MIGRATIONS_ON_START=1

# FastAPI source reload inside Compose. 1 enables uvicorn --reload.
# Type: integer | Secret: no | Applies: local
API_RELOAD=1

# Optional Compose profile. Uncomment to start the async worker sidecar.
# Type: string | Secret: no | Applies: local
# COMPOSE_PROFILES=worker

# Watchdog interval in seconds for the optional worker profile
# Type: integer | Secret: no | Applies: local
WORKER_POLL_SECONDS=30

# Public API URL used by the browser (not the Docker network name)
# Type: url | Secret: no | Applies: local, web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Environment badge in the web header
# Type: string | Secret: no | Applies: local, web
NEXT_PUBLIC_APP_ENV=local
