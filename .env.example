# Copy to .env for local use. Never commit .env.
# Local PostgreSQL credentials are development-only and must not be reused in AWS.

# Application environment: local | test | dev | prod
# Type: string | Secret: no | Applies: all
APP_ENV=local

# Log level: DEBUG | INFO | WARNING | ERROR
# Type: string | Secret: no | Applies: all
APP_LOG_LEVEL=INFO

# Semantic version reported by /api/v1/version
# Type: string | Secret: no | Applies: all
APP_VERSION=0.1.0

# Git commit SHA injected at image build time
# Type: string | Secret: no | Applies: all
GIT_SHA=unknown

# RFC 3339 build timestamp injected at image build time
# Type: string | Secret: no | Applies: all
BUILD_TIME=unknown

# SQLAlchemy URL. Driver is normalized to postgresql+psycopg.
# Type: url | Secret: yes | Applies: all
# Local default is not reusable outside this machine.
DATABASE_URL=postgresql+psycopg://budgetlens:budgetlens_local_only@localhost:5433/budgetlens

# Object storage adapter: local | s3
# Type: string | Secret: no | Applies: all
OBJECT_STORAGE_BACKEND=local

# Filesystem path for the local storage adapter
# Type: path | Secret: no | Applies: local, test
LOCAL_STORAGE_PATH=./var/storage

# Authentication adapter: dev | oidc
# Type: string | Secret: no | Applies: all
# AUTH_MODE=dev is rejected when APP_ENV=prod.
AUTH_MODE=dev

# AI adapter: stub | bedrock
# Type: string | Secret: no | Applies: all
AI_PROVIDER=stub

# Bedrock region (unused while AI_PROVIDER=stub)
# Type: string | Secret: no | Applies: aws
BEDROCK_REGION=us-east-1

# Bedrock model identifier (unused while AI_PROVIDER=stub)
# Type: string | Secret: no | Applies: aws
BEDROCK_MODEL_ID=

# Maximum tool calls per copilot turn
# Type: integer | Secret: no | Applies: all
AI_MAX_TOOL_CALLS=4

# Copilot timeout budget in seconds
# Type: integer | Secret: no | Applies: all
AI_TIMEOUT_SECONDS=20

# Maximum upload size in bytes (25 MiB)
# Type: integer | Secret: no | Applies: all
MAX_UPLOAD_BYTES=26214400

# Comma-separated browser origins allowed by CORS
# Type: string | Secret: no | Applies: local, test, dev
CORS_ORIGINS=http://localhost:3000

# Database readiness query timeout in seconds
# Type: float | Secret: no | Applies: all
DB_READY_TIMEOUT_SECONDS=2

# Seconds before a processing import job is marked timed out
# Type: integer | Secret: no | Applies: all
JOB_TIMEOUT_SECONDS=600

# Days to keep original import files before purge
# Type: integer | Secret: no | Applies: all
ORIGINAL_FILE_RETENTION_DAYS=90

# Sliding-window limits per user
# Type: integer | Secret: no | Applies: all
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=10

# Estimated AI cost in micros per usage unit. 0 disables the estimate.
# Type: integer | Secret: no | Applies: all
AI_INPUT_UNIT_COST_MICROS=0
AI_OUTPUT_UNIT_COST_MICROS=0

# Host port mappings (Compose interpolation). Change if a port is busy.
# Type: integer | Secret: no | Applies: local
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5433

# Public API URL used by the browser (not the Docker network name)
# Type: url | Secret: no | Applies: local, web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Environment badge in the web header
# Type: string | Secret: no | Applies: local, web
NEXT_PUBLIC_APP_ENV=local
