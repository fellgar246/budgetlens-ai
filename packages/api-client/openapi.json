{
  "openapi": "3.1.0",
  "info": {
    "title": "BudgetLens API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Live",
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Ready",
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Version",
        "operationId": "version_api_v1_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LiveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "LiveResponse"
      },
      "ReadyComponents": {
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "database"
        ],
        "title": "ReadyComponents"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status"
          },
          "components": {
            "$ref": "#/components/schemas/ReadyComponents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "components"
        ],
        "title": "ReadyResponse"
      },
      "VersionResponse": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "commit": {
            "type": "string",
            "title": "Commit"
          },
          "build_time": {
            "type": "string",
            "title": "Build Time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "commit",
          "build_time"
        ],
        "title": "VersionResponse"
      }
    }
  }
}
