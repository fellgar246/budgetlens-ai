# Copy values you intend to apply. Do not put passwords, tokens, or access keys here.
# Never run terraform apply -auto-approve against this root.
aws_account_id      = "123456789012"
owner               = "your-name"
cost_center         = "prod"
alarm_email         = "alerts@example.com"
domain_name         = "app.example.com"
create_dns_records  = false
additional_app_urls = ["https://app.example.com"]
api_image           = "123456789012.dkr.ecr.us-east-1.amazonaws.com/budgetlens-prod-api@sha256:replace-with-published-digest"
enable_waf          = true
