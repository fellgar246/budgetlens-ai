# Safer production defaults. No secrets belong in this file.
# terraform apply -auto-approve is not used for this root.
environment                 = "prod"
aws_region                  = "us-east-1"
aws_account_id              = ""
owner                       = "portfolio"
cost_center                 = "demo"
data_classification         = "financial"
vpc_cidr                    = "10.50.0.0/16"
availability_zone_count     = 2
nat_gateway_count           = 2
enable_vpc_flow_logs        = true
enable_interface_endpoints  = false
enable_waf                  = false
api_cpu                     = 512
api_memory                  = 1024
api_desired_count           = 2
api_image                   = "000000000000.dkr.ecr.us-east-1.amazonaws.com/budgetlens-prod-api@sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
